NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/reminder-bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=
# Optional — leave unset to use the default (gemini-3.5-flash).
# An empty value is read as an empty model name, so comment it out rather
# than setting it blank.
# GEMINI_MODEL=gemini-3.5-flash